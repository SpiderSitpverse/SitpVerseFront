# URL del back (NestJS). En desarrollo: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Client ID de Google OAuth (público, no es un secreto). Se crea en console.cloud.google.com > APIs y servicios > Credenciales.
# En "Orígenes de JavaScript autorizados" agrega esta URL del front (http://localhost:5173 en desarrollo).
VITE_GOOGLE_CLIENT_ID=
